# Server-only. Never use a VITE_ prefix for credentials.
EIA_API_KEY=

# Production server (npm start). Development Vite does not require these.
# Use the exact externally visible HTTPS origin behind the reverse proxy.
PUBLIC_ORIGIN=
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional defaults: HOST=127.0.0.1, PORT=3000, DIST_DIRECTORY=dist
# Keep data outside immutable releases on a hosted server.
# GRID_SNAPSHOT_DIR=/var/lib/sunchaser/grid
# JOB_RUN_DIRECTORY=/var/lib/sunchaser/jobs
