{
  "name": "torus-hackathon2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "data:eia930": "node scripts/fetch-eia930-snapshot.ts",
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "npm run generate:scheduling-math && npm run generate:execution-math",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate:math": "npm --prefix examples/math-formula-proof run generate && npm run generate:scheduling-math && npm run generate:execution-math",
    "generate:scheduling-math": "node examples/math-formula-proof/generate.mjs src/core/scheduling/math/chooseExecutionSlot.math.md && node examples/math-formula-proof/generate.mjs src/core/scheduling/math/postSitePrice.math.md",
    "test:math": "npm --prefix examples/math-formula-proof test && npm run check:execution-math",
    "test": "vitest run",
    "test:userflows": "playwright test",
    "test:score": "node scripts/score.mjs",
    "score:report": "node scripts/score.mjs --report-only",
    "test:tooling": "node --test test/tooling/score.test.ts test/tooling/ci-summary.test.ts test/tooling/scorecard-links.test.ts",
    "generate:execution-math": "node src/core/execution/runner/math/generate.mjs",
    "check:execution-math": "node src/core/execution/runner/math/generate.mjs --check"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.171.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "read-excel-file": "9.3.13",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.2"
  }
}
