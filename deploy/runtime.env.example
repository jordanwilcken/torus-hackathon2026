# Hosting settings belong on the server, outside the release directory.
# Copy to /etc/sunchaser/runtime.env with mode 0600; replace every placeholder.
# Never commit the completed file or put these values in VITE_* variables.
EIA_API_KEY=REPLACE_ON_SERVER
PUBLIC_ORIGIN=https://demo.example.com
DEMO_USERNAME=judges
DEMO_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
